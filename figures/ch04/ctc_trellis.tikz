% CTC trellis for target "ab": positions of l' = (-, a, -, b, -) down, frames across; forward variables
% from the worked example (Graves 2006 Eqs. 5-8). Valid end nodes are highlighted.
\begin{tikzpicture}[x=2.6cm, y=-0.95cm]
  \foreach \s/\lab in {1/{$-$}, 2/a, 3/{$-$}, 4/b, 5/{$-$}} { \node[note, anchor=east] at (0.55,\s) {\lab}; }
  \foreach \t in {1,2,3} { \node[note] at (\t,0.2) {$t=\t$}; }
  % alpha values: t1: .5 .4 0 0 0 ; t2: .15 .27 .12 .16 0 ; t3: .09 .042 .234 .165 .096
  \foreach \t/\s/\v in {1/1/0.5, 1/2/0.4, 2/1/0.15, 2/2/0.27, 2/3/0.12, 2/4/0.16, 3/1/0.09, 3/2/0.042, 3/3/0.234} {
    \node[device, minimum width=1.3cm, minimum height=0.6cm] (n\t\s) at (\t,\s) {\figsub{\v}}; }
  \foreach \t/\s/\v in {3/4/0.165, 3/5/0.096} {
    \node[device, highlight, minimum width=1.3cm, minimum height=0.6cm] (n\t\s) at (\t,\s) {\figsub{\v}}; }
  \foreach \t/\s in {1/3, 1/4, 1/5, 2/5} {
    \node[blocked, minimum width=1.3cm, minimum height=0.6cm] (n\t\s) at (\t,\s) {\figsub{0}}; }
  % moves from t to t+1: stay, step, and the skip a -> b
  \foreach \a/\b in {11/21, 12/22, 11/22, 12/23, 12/24, 21/31, 22/32, 21/32, 22/33, 23/33, 22/34, 23/34, 24/34, 24/35} {
    \draw[link] (n\a) -- (n\b); }
  \node[note, anchor=west] at (3.35,4.5) {$p(\mathrm{ab}\mid x) = 0.165 + 0.096 = 0.261$};
\end{tikzpicture}
