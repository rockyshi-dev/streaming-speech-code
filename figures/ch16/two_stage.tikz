% vLLM-Omni's two-stage serving of Qwen3-TTS (deploy/qwen3_tts.yaml at v0.32.0).
\begin{tikzpicture}[node distance=6mm]
  \node[data] (req) {\figtitle{requests}\\\figsub{HTTP or WebSocket}};
  \node[device, right=10mm of req, minimum width=3.6cm] (talker) {\figtitle{stage 0: talker}\\\figsub{language model, KV cache,}\\\figsub{continuous batching}};
  \node[memory, right=10mm of talker] (shm) {\figtitle{shared memory}\\\figsub{codec frames}};
  \node[device, highlight, right=10mm of shm, minimum width=3.6cm] (c2w) {\figtitle{stage 1: code2wav}\\\figsub{codec decoder, state per}\\\figsub{request, batches of chunks}};
  \node[data, right=10mm of c2w] (pcm) {\figtitle{PCM chunks}\\\figsub{24 kHz}};
  \draw[dataflow] (req) -- (talker); \draw[dataflow] (talker) -- (shm);
  \draw[dataflow] (shm) -- (c2w); \draw[dataflow] (c2w) -- (pcm);
  \node[note, below=3mm of shm] {first chunk 1 frame (80 ms), then 25 frames (2 s); 72 frames of left context};
\end{tikzpicture}
