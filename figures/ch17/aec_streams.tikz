% Echo cancellation needs the render (far-end) signal and the capture (near-end) signal on one clock.
\begin{tikzpicture}[node distance=7mm]
  \node[device, minimum width=2.6cm, minimum height=0.9cm] (far) {\figtitle{far-end audio}};
  \node[device, minimum width=2.2cm, minimum height=0.9cm, right=16mm of far] (spk) {\figtitle{speaker}};
  \node[memory, minimum width=2.2cm, minimum height=0.9cm, right=10mm of spk] (room) {\figtitle{room}};
  \node[device, minimum width=2.2cm, minimum height=0.9cm, below=12mm of room] (mic) {\figtitle{microphone}};
  \node[device, highlight, minimum width=2.6cm, minimum height=0.9cm, below=12mm of far] (aec) {\figtitle{echo canceller}};
  \node[device, minimum width=2.6cm, minimum height=0.9cm, below=10mm of aec] (out) {\figtitle{to the recognizer}};
  \draw[dataflow] (far) -- (spk);
  \draw[dataflow] (spk) -- (room);
  \draw[dataflow] (room) -- node[note, right] {echo} (mic);
  \draw[dataflow] (mic) -- node[note, above] {capture stream} (aec);
  \draw[link] (far) -- node[note, left] {render stream (reference)} (aec);
  \draw[dataflow] (aec) -- (out);
  \node[group, fit=(far)(spk)(room)(mic)(aec), inner sep=3mm, label={[note]above:on the device, one audio clock}] {};
\end{tikzpicture}
