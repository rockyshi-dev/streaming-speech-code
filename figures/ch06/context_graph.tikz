% A hotword context graph (icefall context_graph.py, Aho-Corasick): a trie over the tokens of the
% phrases, a bonus per matched token, and a fail arc from each node back toward the root.
\begin{tikzpicture}[x=2.3cm, y=1.6cm]
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (root) at (0,0) {\figsub{root}};
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (n1) at (1,1) {\figsub{\_NE}};
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (n2) at (2,1) {\figsub{MO}};
  \node[device, highlight, minimum width=1.3cm, minimum height=0.7cm] (n3) at (3,1) {\figsub{match}};
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (m1) at (1,-1) {\figsub{\_NV}};
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (m2) at (2,-1) {\figsub{ID}};
  \node[device, minimum width=1.3cm, minimum height=0.7cm] (m3) at (3,-1) {\figsub{IA}};
  \node[device, highlight, minimum width=1.3cm, minimum height=0.7cm] (m4) at (4,-1) {\figsub{match}};
  \draw[dataflow] (root) -- node[note, above left] {+1.5} (n1);
  \draw[dataflow] (n1) -- node[note, above] {+1.5} (n2);
  \draw[dataflow] (n2) -- (n3);
  \draw[dataflow] (root) -- node[note, below left] {+1.5} (m1);
  \draw[dataflow] (m1) -- node[note, below] {+1.5} (m2);
  \draw[dataflow] (m2) -- node[note, below] {+1.5} (m3);
  \draw[dataflow] (m3) -- (m4);
  \draw[link] (n2.north) .. controls (2,2.1) and (-0.2,2.0) .. node[note, above] {fail} (root.north);
  \draw[link] (m3.south) .. controls (3,-2.1) and (-0.2,-2.0) .. node[note, below] {fail} (root.south);
\end{tikzpicture}
